# Public frontend API origin, without /api. Leave empty for the local Vite proxy.
# In Vercel set: VITE_API_BASE_URL=https://YOUR_RENDER_SERVICE.onrender.com
VITE_API_BASE_URL=
# Local development proxy only; this does not configure the built Vercel website.
VITE_API_TARGET=http://127.0.0.1:8000
# Never put database URLs, passwords, admin secrets or tokens in VITE_* values.
