# Provider dashboard values only. Never copy the local database URL/password here.
APP_ENV=production
DATABASE_URL=postgresql://DEMO_USER:URL_ENCODED_DEMO_PASSWORD@HOSTED_POSTGRES_HOST:5432/DEMO_DATABASE?sslmode=require
FRONTEND_ORIGINS=https://YOUR_PROJECT.vercel.app
DATABASE_SSLMODE=require
UPLOADS_ENABLED=false
SESSION_HOURS=24
COMMISSION_PERCENT=5
# Uploads require persistent storage before enabling:
# UPLOADS_ENABLED=true
# UPLOAD_DIR=/var/data/uploads
# Optional admin bootstrap belongs only in the provider's secret settings, never Git.
