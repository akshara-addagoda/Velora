# Run backend/app/setup_postgres.py to validate the existing database and safely encode the password.
# Database names are case-sensitive: the existing local database is Velora.
DATABASE_URL=postgresql+psycopg://postgres:YOUR_URL_ENCODED_PASSWORD@127.0.0.1:5432/Velora
FRONTEND_ORIGIN=http://127.0.0.1:5173
COMMISSION_PERCENT=5
SESSION_HOURS=24
# Optional development administrator. Set both before running the seed command.
ADMIN_EMAIL=
ADMIN_PASSWORD=
